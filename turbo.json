{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APP_URL",
    "BACKEND_URL",
    "BE_PORT",
    "BE_URL",
    "CORS_ALLOW_CREDENTIALS",
    "CORS_ALLOWED_HEADERS",
    "CORS_ALLOWED_METHODS",
    "CORS_ALLOWED_ORIGINS",
    "DATABASE_URL",
    "DEV_LOGIN_SECRET",
    "NODE_ENV",
    "NEXT_PUBLIC_BE_URL",
    "NEXT_PUBLIC_WS_URL",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "SESSION_COOKIE_NAME",
    "SESSION_TTL_MS",
    "WORKER_SECRET",
    "WORKER_URL",
    "WS_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
